# ---------------------------------------------------------------------------
# Scene by Scene environment
#
# Copy to `.env.local` and fill in the real values. `.env.local` is gitignored;
# never commit real keys, and never paste a secret key into this file.
# ---------------------------------------------------------------------------

# Supabase — Project Settings → API Keys
# Both are safe to expose to the browser. The publishable key is protected by
# row level security, not by secrecy.
#
# `NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY` is Supabase's current name for what
# older projects and docs call the "anon" key. If your dashboard still shows
# `anon public`, that is the same value.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ---------------------------------------------------------------------------
# OAuth provider credentials
#
# These are NOT read by this app. Supabase performs the OAuth exchange, so the
# client ids and secrets are entered in the Supabase dashboard under
# Authentication → Providers. They are listed here only so you know what each
# provider console will ask you to create.
#
#   Google    → Client ID + Client Secret        (Google Cloud Console)
#   Apple     → Services ID + Team ID + Key ID + .p8 private key (Apple Developer)
#   Facebook  → App ID + App Secret              (Meta for Developers)
#
# Callback URL to register with every provider console:
#   https://your-project-ref.supabase.co/auth/v1/callback
#
# Redirect URLs to allow-list in Supabase (Authentication → URL Configuration):
#   http://localhost:3000/auth/callback
#   https://your-production-domain/auth/callback
# ---------------------------------------------------------------------------
